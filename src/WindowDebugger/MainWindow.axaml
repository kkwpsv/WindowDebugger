<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:WindowDebugger.Views"
        xmlns:l="using:WindowDebugger.Localizations"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WindowDebugger.MainWindow"
        x:Name="MainWindowInstance"
        Width="1280" Height="960" WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="40"
        Icon="/Assets/Icons/icon.ico" Background="Transparent"
        Title="{Binding Product.LocalizedName, Source={x:Static l:Lang.Current}}">

    <Border Margin="{Binding #MainWindowInstance.OffScreenMargin}">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"
                    Background="{OnPlatform #262626, Windows=Transparent, Linux=#262626, macOS=Transparent}" />
            <Grid x:Name="ContentPanel" Grid.Row="0" Grid.RowSpan="2" Margin="{OnPlatform Linux=0 -32 0 0}">
                <Border x:Name="TransientBorder" />
                <views:MainView x:Name="MainView" />
                <StackPanel Orientation="Horizontal" Margin="0 0 140 0"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel.Styles>
                        <Style Selector="Button.WindowGlobalButton, ToggleButton.WindowGlobalButton">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="Width" Value="42" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="Svg.ButtonIcon">
                            <Setter Property="Width" Value="16" />
                            <Setter Property="Height" Value="16" />
                            <Setter Property="Stretch" Value="Uniform" />
                        </Style>
                        <Style Selector="Svg.Pin">
                            <Setter Property="Path" Value="/Assets/UI/pushpin.svg" />
                        </Style>
                        <Style Selector="ToggleButton:checked Svg.Pin">
                            <Setter Property="Path" Value="/Assets/UI/pushpin-fill.svg" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Classes="WindowGlobalButton" Margin="4 0 0 0" Click="UacButton_Click"
                            IsVisible="{OnPlatform False, Windows=True}">
                        <ToolTip.Tip>
                            <TextBlock LineHeight="24">
                                <Run FontSize="14" FontWeight="Bold" Text="{Binding App.UI.UacButton.ToolTip.Title, Source={x:Static l:Lang.Current}}" />
                                <LineBreak />
                                <Run Text="{Binding App.UI.UacButton.ToolTip.Description, Source={x:Static l:Lang.Current}}" />
                            </TextBlock>
                        </ToolTip.Tip>
                        <Svg Classes="ButtonIcon" Path="/Assets/UI/shield-color.svg" />
                    </Button>
                    <ToggleButton Classes="WindowGlobalButton" IsCheckedChanged="TopMostToggleButton_IsCheckedChanged">
                        <ToolTip.Tip>
                            <TextBlock LineHeight="24">
                                <Run FontSize="14" FontWeight="Bold"
                                     Text="{Binding App.UI.TopmostButton.ToolTip.Title, Source={x:Static l:Lang.Current}}" />
                                <LineBreak />
                                <Run
                                    Text="{Binding App.UI.TopmostButton.ToolTip.Description, Source={x:Static l:Lang.Current}}" />
                            </TextBlock>
                        </ToolTip.Tip>
                        <Svg Classes="ButtonIcon Pin" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Height="40" IsVisible="{OnPlatform True, Linux=False}">
                <Grid.Styles>
                    <Style Selector="Button">
                        <Setter Property="Transitions">
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.6"
                                                               Easing="CircularEaseOut" />
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="TextBlock">
                        <Setter Property="Transitions">
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4"
                                                               Delay="0:0:0.2" Easing="CircularEaseOut" />
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Button">
                        <Setter Property="RenderTransform" Value="translateX(-80px)" />
                        <Style Selector="^.HasBack">
                            <Setter Property="RenderTransform" Value="translateX(0px)" />
                        </Style>
                    </Style>
                    <Style Selector="TextBlock">
                        <Setter Property="RenderTransform" Value="translateX(-32px)" />
                        <Style Selector="^.HasBack">
                            <Setter Property="RenderTransform" Value="translateX(0px)" />
                        </Style>
                    </Style>
                </Grid.Styles>
                <Button x:Name="BackButton" Grid.Column="0"
                        Width="40" Height="32"
                        Margin="4 4 -8 4" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Background="Transparent"
                        Focusable="False"
                        FontSize="16" Content="🔙"
                        Click="BackButton_Click" />
                <TextBlock x:Name="TitleTextBlock" Grid.Column="1"
                           Margin="12 0 0 0" FontSize="12"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="{Binding Product.LocalizedName, Source={x:Static l:Lang.Current}}" />
            </Grid>
        </Grid>
    </Border>

</Window>
