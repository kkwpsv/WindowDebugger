<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.0</Version>
    <ApplicationIcon>Assets\Icons\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <IsLegacyFramework>true</IsLegacyFramework>
    <IsLegacyFramework Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">false</IsLegacyFramework>
  </PropertyGroup>

  <PropertyGroup Condition="$(IsLegacyFramework) != true">
    <IsAotCompatible>true</IsAotCompatible>
    <!-- 当 AOT 启用时，System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported 开关将被关闭，设计器将无法工作。 -->
    <PublishAot Condition="'$(Configuration)' != 'Debug'">true</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="$(IsLegacyFramework) == true">
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.9" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="DotNetCampus.LatestCSharpFeatures" Version="13.0.1" />
    <PackageReference Include="dotnetCampus.Logger" Version="1.3.0-alpha02" />
    <PackageReference Include="dotnetCampus.SourceLocalizations" Version="0.1.0-alpha20" />
    <PackageReference Include="Lsj.Util.Win32" Version="9.0.0" />
    <PackageReference Include="Lsj.Util.Win32.NativeUI" Version="9.0.0" />
    <PackageReference Condition="$(IsLegacyFramework) != true" Include="SeWzc.X11Sharp" Version="0.1.0-alpha17" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="11.3.0.2-beta.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Icons\**\*.png" />
    <AvaloniaResource Include="Assets\Icons\**\*.ico" />
    <AvaloniaResource Include="Assets\UI\**\*.svg" />
    <AvaloniaResource Include="Assets\UI\**\*.png" />
    <AvaloniaResource Include="Assets\Fonts\**\*.ttf" />
    <AvaloniaResource Remove="Views\Details\Linux\**" />
  </ItemGroup>

  <ItemGroup Condition="$(IsLegacyFramework) == true">
    <Compile Remove="Services\NativeWindows\Linux\**" />
    <Compile Include="Services\NativeWindows\Linux\LinuxNativeWindowModel.cs" />
    <Compile Remove="**\*.linux.cs" />
    <Compile Remove="Views\Details\Linux\**" />
    <AvaloniaXaml Remove="Views\Details\Linux\**" />
    <EmbeddedResource Remove="Views\Details\Linux\**" />
    <AdditionalFiles Remove="Views\Details\Linux\**" />
  </ItemGroup>

</Project>
